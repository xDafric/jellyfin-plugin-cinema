<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cinema" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">#111113</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:alertDialogTheme">@style/Dialog.Cinema</item>
    </style>
    <style name="Dialog.Cinema" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0B0B8</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>
</resources>
